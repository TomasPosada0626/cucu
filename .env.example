# .env.example
# Plantilla de variables de entorno para CUCU. Copia este archivo como .env y ajusta los valores.

# Django
# False por defecto a propósito (secure by default): un 500 sin manejar con
# DEBUG=True expone tracebacks completos, queries SQL y rutas del sistema a
# cualquier visitante. Poné True solo en tu .env local si necesitás las
# páginas de error de Django para desarrollar - nunca en un .env de despliegue.
DEBUG=False
SECRET_KEY="django-insecure-tu-clave-secreta-aqui"
# Sin comodín (*): eso desactiva la validación de Host header de Django, que
# es una protección real (host header injection, envenenamiento de links de
# reset de password). Agregá tu dominio/IP real acá al desplegar - ver
# README_DEPLOY_AWS.md.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Requerido si el sitio se sirve por HTTPS detras de Nginx (ver README_DEPLOY_AWS.md)
CSRF_TRUSTED_ORIGINS=

# Postgres (monolito) - self-hosted en el propio docker-compose, sin costo de
# base de datos gestionada. Cambiá POSTGRES_PASSWORD por un valor propio.
POSTGRES_DB=cucu
POSTGRES_USER=cucu
POSTGRES_PASSWORD="cambia-esta-clave"

# Servicios y Microservicios
GEO_SERVICE_URL=http://geo-service:8081
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8082
SUPPORT_SERVICE_URL=http://support-service:8085

# Radio (en km) dentro del cual un repartidor ve "pedidos cercanos"
REPARTIDOR_RADIO_PEDIDOS_CERCANOS_KM=8.0

# Web Push (opcional) - vacio desactiva el envio, no rompe nada. Generar un
# par propio con: python -c "from py_vapid import Vapid02; v=Vapid02();
# v.generate_keys(); v.save_key('private_key.pem'); v.save_public_key('public_key.pem')"
# o con la CLI `vapid --gen` de la libreria py-vapid (instalada junto con pywebpush).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_ADMIN_EMAIL="no-reply@cucu.local"

# API de Terceros y Servicios Aliados
GOOGLE_MAPS_API_KEY="tu_api_key_de_google_maps_aqui"
ALLY_SERVICE_URL="http://servicio-aliado-mock.local" # Opcional: URL real del equipo aliado

# Observabilidad (opcional) - dejar vacío desactiva el tracking, no rompe nada
SENTRY_DSN=""

# HSTS (opcional) - 0 desactiva. En producción real, usar 15552000 (6 meses)
# o 31536000 (1 año) recién después de confirmar que HTTPS funciona siempre.
SECURE_HSTS_SECONDS=0

# Celery & RabbitMQ & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PAYMENTS_QUEUE=payments.events

# Correo
DEFAULT_FROM_EMAIL="no-reply@cucu.local"
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"

# Auth Microservice
AUTH_JWT_SECRET="super-secret-key-for-jwt-change-me"
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
