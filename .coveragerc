[run]
source = .
branch = True
omit =
    */migrations/*
    manage.py
    config/wsgi.py
    config/asgi.py
    */tests.py
    *_microservice/*
    venv/*
    .venv/*
    */site-packages/*
    # Boilerplate de `startapp` (from django.shortcuts import render) que
    # nunca se conecta a ninguna url.py; las vistas reales viven en
    # */interfaces/api/views.py. Confirmado sin referencias en todo el repo.
    geo/views.py
    transactions/views.py

[report]
precision = 1
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    # Metodos de interfaces Protocol (cuerpo `...`): nunca se ejecutan
    # directo, solo definen forma para type-checking. Coverage.py cuenta
    # cada uno como una rama parcial ("N->exit") porque nunca "continua" a
    # la siguiente linea, lo cual no es un hueco real de tests.
    : \.\.\.$
